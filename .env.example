# Public deployment URL; leave empty for local development.
NEXT_PUBLIC_SITE_URL=

# Neon: server-only URL from the selected Neon branch and portfolio_app role.
# Retain sslmode=require (or verify-full) from the supplied connection string.
# APIs use Neon. No migration runs automatically. Use a development branch for tests.
DATABASE_URL=

# Optional public Vercel Blob store; token is SERVER ONLY. No NEXT_PUBLIC_ prefix.
# Hostname only, e.g. the store's public.blob.vercel-storage.com host (no URL/path).
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_HOSTNAME=
# Images remain local until Blob is configured. Uploads are capped at 3 MiB/image.
# Supabase URL/service-role are no longer required by any active API.

# Admin: generate your own strong password and random JWT secret (32+ bytes).
ADMIN_PASSWORD=
JWT_SECRET=

# Optional email form and admin email; verified sender required.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
ADMIN_EMAIL=

# Optional integrations. No fabricated phone number or key is used.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ENABLE_NEWSLETTER=false
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
COMING_SOON_PASSWORD=
# Legacy MongoDB models are retained, but current APIs use Neon.
MONGODB_URI=
